# syntax=docker/dockerfile:1
FROM node:20-alpine AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
# Empty by default → the app uses same-origin relative URLs ("/api/v1"),
# which is correct behind the nginx proxy. Set only for split-origin deploys.
ARG VITE_API_URL=
ARG VITE_WS_URL=
ARG VITE_APP_NAME=
ARG VITE_STORAGE_PREFIX=
ENV VITE_API_URL=$VITE_API_URL VITE_WS_URL=$VITE_WS_URL \
    VITE_APP_NAME=$VITE_APP_NAME VITE_STORAGE_PREFIX=$VITE_STORAGE_PREFIX
RUN npm run build

FROM nginx:1.27-alpine
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
