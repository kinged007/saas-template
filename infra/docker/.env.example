# Docker Compose project and branding
COMPOSE_PROJECT_NAME=app
APP_NAME=Application
APP_SLUG=app
# Optional path or public URL for a custom frontend wordmark.
VITE_LOGO_URL=

# PostgreSQL
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=change-me

# API secrets
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
FERNET_KEYS=change-me-fernet-key-32-bytes-min
SECRET_ENCRYPT_VERSION=1
# Stateful browser identifier. Changing it signs existing browser sessions out.
REFRESH_COOKIE_NAME=app_refresh

# Public URLs
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
