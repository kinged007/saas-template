# --- Production stack (infra/docker/docker-compose.prod.yml) ---
#   cp infra/docker/.env.example infra/docker/.env
# Compose refuses to start without POSTGRES_PASSWORD, SECRET_KEY and FERNET_KEYS.

# Password of the bundled postgres service. Any random string.
POSTGRES_PASSWORD=

# Signs access tokens and CSRF tokens. Generate with: openssl rand -hex 32
SECRET_KEY=

# Fernet keys for secrets at rest, comma separated, newest first. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep them with your backups or the stored secrets cannot be decrypted.
FERNET_KEYS=
# 1-based index into FERNET_KEYS used to encrypt new secrets. Bump on rotation.
SECRET_ENCRYPT_VERSION=1

# --- Optional overrides (defaults in parentheses) ---

# Peers whose X-Forwarded-For uvicorn honours: an IP, a CIDR, or a
# comma-separated list. The default is the compose network pinned in
# docker-compose.prod.yml, which is where nginx lives. Add an external load
# balancer or CDN here, or every recorded client IP becomes theirs — including
# the IP-keyed auth and register rate limiters' buckets. Register is the
# sensitive one: its key is the IP alone, so an unlisted proxy collapses all
# signups site-wide into one shared register window (see docs/OPERATIONS.md).
# FORWARDED_ALLOW_IPS=172.30.0.0/24

# Host port the SPA is published on (8080).
# WEB_PORT=8080

# Public origin of the app, used for links in emails. CORS only matters for
# split-origin deployments; the same-origin proxy needs none.
# FRONTEND_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:8080
