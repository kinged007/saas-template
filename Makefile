SHELL := /bin/bash
.DEFAULT_GOAL := help

SUDO := $(shell [ "$$(id -u)" -eq 0 ] 2>/dev/null && echo "" || echo sudo)

.PHONY: help setup check-node dev api api-install api-migrate api-seed api-test api-lint web web-install web-build web-test web-typecheck web-test-e2e hooks-install db-check label-contract db-squash db-new db-new-project db-history infra-up infra-down nats-up nats-down nats-status nats-logs

# USE_SQLITE=1 (env or `make <target> USE_SQLITE=1`): use the per-checkout
# sqlite dev DB (apps/api/dev.db) instead of embedded postgres. Exported so it
# reaches sub-makes and dev.py's child processes. (A trailing `--sqlite` flag
# is not possible: GNU make parses `--long` args as its own options.)
ifdef USE_SQLITE
export USE_SQLITE
endif

API_PORT ?= 8000
WEB_PORT ?= 5173

# Node floor for apps/web — keep in sync with apps/web/package.json "engines".
# The API is Python, so it has no Node requirement.
WEB_NODE_MAJOR := 22
WEB_NODE_MINOR := 18

help:
	@echo "SaaS Template targets (development runs from the terminal — no docker needed):"
	@echo "  make setup        one-time: install uv + Node.js if missing (fnm -> apt -> nvm)"
	@echo "  make check-node   warn if Node is below the apps/web floor ($(WEB_NODE_MAJOR).$(WEB_NODE_MINOR))"
	@echo "  make dev          install deps, migrate, seed, then run api (:$(API_PORT)) + web (:$(WEB_PORT))"
	@echo "  make dev API_PORT=8010 WEB_PORT=5273   use other ports (e.g. when :8000/:5173 are taken)"
	@echo "  make api-install  install backend deps + dev tooling (uv sync --extra dev)"
	@echo "  make api-migrate  run alembic migrations (starts embedded postgres)"
	@echo "  USE_SQLITE=1 make dev  sqlite dev DB (apps/api/dev.db) instead of postgres"
	@echo "  make api-seed     seed default demo users + workspaces"
	@echo "  make api          run backend (uvicorn, :$(API_PORT))"
	@echo "  make api-test     run backend tests (scratch sqlite file, no docker required)"
	@echo "  make api-lint     ruff check + format check (same as pre-commit hook)"
	@echo "  make hooks-install install pre-commit hooks (uv tool install pre-commit first)"
	@echo "  make db-check     migration hygiene: template + project heads, models match migrations"
	@echo "  make label-contract  fleet label contract: .agents/ labels match docs/FLEET_LABELS.md"
	@echo "  make db-squash m=\"..\"  squash versions/ into one baseline (release boundary only)"
	@echo "  make db-new m=\"..\" new autogenerated template migration (review the diff before commit)"
	@echo "  make db-new-project m=\"..\"  new autogenerated project-branch migration (review the diff before commit)"
	@echo "  make db-history   show the migration chain"
	@echo "  make web-install  install frontend deps"
	@echo "  make web          run frontend (vite, :$(WEB_PORT))"
	@echo "  make web-build    type-check + build frontend"
	@echo "  make web-test     run frontend unit tests (node --test, stdlib only)"
	@echo "  make web-typecheck type-check frontend (tsc --noEmit)"
	@echo "  make web-test-e2e run frontend e2e tests (playwright; no API needed)"
	@echo ""
	@echo "Optional (prod-like testing with NATS, requires docker — no compose needed):"
	@echo "  make nats-up      start a NATS JetStream container (plain docker run)"
	@echo "  make nats-down    stop + remove the NATS container"
	@echo "  make nats-status  show NATS container + JetStream state"
	@echo "  make nats-logs    tail NATS container logs"
	@echo "  make api-test-nats run backend tests against a real NATS (skips if nats not up)"

setup:
	@if command -v uv >/dev/null 2>&1; then \
		echo "==> uv already installed: $$(uv --version)"; \
	else \
		echo "==> Installing uv..."; \
		curl -LsSf https://astral.sh/uv/install.sh | sh || { echo "error: uv install failed (need curl + internet)"; exit 1; }; \
	fi
	@if command -v node >/dev/null 2>&1; then \
		echo "==> Node.js already installed: $$(node --version)"; \
		$(MAKE) --no-print-directory check-node; \
	else \
		echo "==> Node.js not found — trying installers (fnm, then apt, then nvm)..."; \
		FNM_BIN=""; \
		if command -v fnm >/dev/null 2>&1; then \
			echo "    -> fnm already installed"; \
		elif curl -fsSL https://fnm.vercel.app/install | bash >/dev/null 2>&1; then \
			echo "    -> installed via fnm"; \
		else \
			echo "    fnm install failed"; \
		fi; \
		for d in "$$HOME/.fnm" "$$XDG_DATA_HOME/fnm" "$$HOME/.local/share/fnm"; do \
			if [ -n "$$d" ] && [ -x "$$d/fnm" ]; then FNM_BIN="$$d"; break; fi; \
		done; \
		if [ -n "$$FNM_BIN" ]; then \
			export PATH="$$FNM_BIN:$$PATH"; \
			fnm install --lts; \
		elif command -v apt-get >/dev/null 2>&1; then \
			echo "    -> trying apt-get"; \
			$(SUDO) apt-get update && $(SUDO) apt-get install -y nodejs npm || echo "    apt install failed"; \
		else \
			echo "    -> trying nvm"; \
			curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash >/dev/null 2>&1 || { echo "error: all installers failed — install Node.js from https://nodejs.org"; exit 1; }; \
			export NVM_DIR="$$HOME/.nvm"; \
			. "$$NVM_DIR/nvm.sh"; \
			nvm install --lts; \
		fi; \
		if command -v node >/dev/null 2>&1; then \
			echo "==> Node.js ready: $$(node --version)"; \
			$(MAKE) --no-print-directory check-node; \
		else \
			echo "==> Done — open a new terminal (or run: source ~/.bashrc) so node is on PATH"; \
		fi; \
	fi

# Warns (never fails) when the running Node is below the floor apps/web declares:
# Node 22.18+ strips TS types natively, which `make web-test` relies on.
check-node:
	@if command -v node >/dev/null 2>&1; then \
		NODE_VERSION=$$(node --version); NODE_VERSION=$${NODE_VERSION#v}; \
		NODE_MAJOR=$${NODE_VERSION%%.*}; \
		NODE_MINOR=$${NODE_VERSION#*.}; NODE_MINOR=$${NODE_MINOR%%.*}; NODE_MINOR=$${NODE_MINOR:-0}; \
		case "$$NODE_MAJOR$$NODE_MINOR" in *[!0-9]*) exit 0;; esac; \
		if [ "$$NODE_MAJOR" -lt $(WEB_NODE_MAJOR) ] || \
		   { [ "$$NODE_MAJOR" -eq $(WEB_NODE_MAJOR) ] && [ "$$NODE_MINOR" -lt $(WEB_NODE_MINOR) ]; }; then \
			echo "    warning: apps/web requires Node >= $(WEB_NODE_MAJOR).$(WEB_NODE_MINOR) (found $$NODE_VERSION) — 'make web-test' needs its native TS type stripping"; \
			echo "             the API has no Node requirement; only apps/web needs $(WEB_NODE_MAJOR).$(WEB_NODE_MINOR)"; \
		fi; \
	fi

dev:
	@command -v uv >/dev/null 2>&1 || { echo "error: uv not found — run 'make setup' first"; exit 1; }
	@command -v node >/dev/null 2>&1 || { echo "error: node not found — run 'make setup' first"; exit 1; }
	$(MAKE) api-install web-install
	$(MAKE) api-migrate
	$(MAKE) api-seed
	@echo "==> Starting API (:$(API_PORT)) and web (:$(WEB_PORT)) — Ctrl-C stops both"
	@if command -v python3 >/dev/null 2>&1; then \
		python3 scripts/dev.py; \
	elif [ -x apps/api/.venv/bin/python ]; then \
		apps/api/.venv/bin/python scripts/dev.py; \
	else \
		echo "error: python3 not found — install Python 3 (the API requires it anyway)"; exit 1; \
	fi

api-install:
	cd apps/api && uv sync --extra dev

api-migrate:
	cd apps/api && uv run alembic upgrade heads

api-seed:
	cd apps/api && uv run python -m src.seed

db-check:
	./scripts/db-check.sh

label-contract:
	./scripts/check-label-contract.sh

db-squash:
	./scripts/db-squash.sh

db-new:
	@REV_ID=$$(date -u +%Y%m%d%H%M%S); \
	while ls apps/api/alembic/versions/$${REV_ID}_*.py apps/api/alembic/project_versions/$${REV_ID}_*.py >/dev/null 2>&1 || grep -rq "^revision = '$${REV_ID}'" apps/api/alembic/versions/ apps/api/alembic/project_versions/ 2>/dev/null; do \
		sleep 1; \
		REV_ID=$$(date -u +%Y%m%d%H%M%S); \
	done; \
	cd apps/api && uv run alembic revision --autogenerate --rev-id "$${REV_ID}" --head template@head -m "$(m)"

db-new-project:
	@REV_ID=$$(date -u +%Y%m%d%H%M%S); \
	while ls apps/api/alembic/project_versions/$${REV_ID}_*.py apps/api/alembic/versions/$${REV_ID}_*.py >/dev/null 2>&1 || grep -rq "^revision = '$${REV_ID}'" apps/api/alembic/versions/ apps/api/alembic/project_versions/ 2>/dev/null; do \
		sleep 1; \
		REV_ID=$$(date -u +%Y%m%d%H%M%S); \
	done; \
	if ls apps/api/alembic/project_versions/*.py >/dev/null 2>&1; then \
		HEAD_ARGS="--head=project@head"; \
	else \
		HEAD_ARGS="--head=base --depends-on=template@head"; \
	fi; \
	cd apps/api && uv run alembic revision --autogenerate --rev-id "$${REV_ID}" $${HEAD_ARGS} --branch-label project --version-path alembic/project_versions -m "$(m)"

db-history:
	cd apps/api && uv run alembic history

api:
	cd apps/api && uv run uvicorn src.main:app --reload --port $(API_PORT)

api-test:
	cd apps/api && uv run --extra dev pytest

api-lint:
	cd apps/api && uv run --extra dev ruff check . && uv run --extra dev ruff format --check .

web-install:
	cd apps/web && npm install

web:
	cd apps/web && API_PORT=$(API_PORT) WEB_PORT=$(WEB_PORT) npm run dev

web-build:
	@$(MAKE) --no-print-directory check-node
	cd apps/web && npm run build

web-test:
	@$(MAKE) --no-print-directory check-node
	cd apps/web && npm test

web-typecheck:
	@if [ ! -x apps/web/node_modules/.bin/tsc ]; then echo "error: apps/web/node_modules/.bin/tsc missing — run 'make web-install' first"; exit 1; fi
	cd apps/web && npx tsc -p tsconfig.json --noEmit

web-test-e2e:
	cd apps/web && npx playwright install chromium && npm run test:e2e

hooks-install:
	pre-commit install --config .pre-commit-config.yaml

infra-up:
	./scripts/nats.sh start

infra-down:
	./scripts/nats.sh stop

nats-up:
	./scripts/nats.sh start

nats-down:
	./scripts/nats.sh stop

nats-status:
	./scripts/nats.sh status

nats-logs:
	./scripts/nats.sh logs

api-test-nats:
	./scripts/nats.sh start
	cd apps/api && uv run --extra dev pytest tests/test_nats_integration.py -v
