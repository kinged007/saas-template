# Web app branding. VITE_APP_NAME drives the document title and the logo alt
# text; VITE_STORAGE_PREFIX namespaces localStorage keys.
# VITE_APP_NAME=SaaS Template
# VITE_STORAGE_PREFIX=tf
#
# Same-origin by default (vite dev proxy / nginx forwards /api to the backend).
# Set an absolute URL only when the frontend is served from a different origin.
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_WS_URL=ws://localhost:8000/api/v1/ws
# Environment name, mirroring the API's ENVIRONMENT. Any value starting with
# "dev" (case-insensitive) shows developer notes in the UI and keeps them in the
# compiled bundle; any other value drops them at build time. Defaults to the Vite
# mode: "development" for the dev server, "production" for `npm run build`.
# VITE_ENVIRONMENT=development
