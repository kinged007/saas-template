# Web branding. Keep APP_SLUG aligned with the API value.
VITE_APP_NAME=SaaS Template
VITE_APP_SLUG=saas-template
# Optional public URL or bundled path for a custom wordmark.
# VITE_LOGO_URL=/brand/logo.svg

# Same-origin by default (vite dev proxy / nginx forwards /api to the backend).
# Set an absolute URL only when the frontend is served from a different origin.
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_WS_URL=ws://localhost:8000/api/v1/ws
