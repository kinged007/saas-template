# --- SaaS Template API ---
# Core
ENVIRONMENT=development
APP_NAME=saas-template-api
DEBUG=true

# Database -- leave DATABASE_URL unset for embedded PostgreSQL (pgserver,
# no docker, no external services). Set it to override (managed postgres etc).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/saas_template
# EMBEDDED_DB_DIR=~/.local/share/saas-template/pgdata

# Security
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FERNET_KEYS=change-me-fernet-key-32-bytes-min
SECRET_ENCRYPT_VERSION=1
SECRET_STORE_DRIVER=db

# Event bus: inprocess (dev) | nats (NATS JetStream)
EVENT_BUS_DRIVER=inprocess
NATS_URL=nats://localhost:4222

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Superadmin bootstrap: the account registered with this email becomes the
# superuser (global scheduled jobs). Empty = no superadmin.
SUPERADMIN_EMAIL=admin@example.com

# Agents
# Empty = OpenRouter's free router (openrouter/free). Keys are per-agent
# secrets (Agents → edit → Secrets & env) or server env vars.
# AGENT_DEFAULT_MODEL=openrouter/free
# Embedding retrieval (pgvector). Off in dev/embedded: memories are retrieved
# by recency only. Requires a managed Postgres with pgvector once enabled.
# VECTOR_ENABLED=false
# Max memories kept per kind (fact/preference/summary) per (workspace, agent, user) triple.
# AGENT_MEMORY_PRUNE_KEEP=100
# Usage cost table: JSON mapping model id -> cents per 1k tokens, e.g.
#   {"gpt-4o": {"input": 0.25, "output": 1.0}, "openrouter/free": {"input": 0, "output": 0}}
# Models absent from the table are recorded with cost 0.
# AGENT_COST_TABLE=

# Scheduled jobs
JOBS_SCHEDULER_TICK_SECONDS=10
JOBS_DEFAULT_TIMEOUT_SECONDS=600
JOBS_RUN_RETENTION=1000
