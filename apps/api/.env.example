# --- SaaS Template API ---
# Core
ENVIRONMENT=development
APP_NAME=saas-template-api
DEBUG=true

# Database -- leave DATABASE_URL unset for embedded PostgreSQL (pgserver,
# no docker, no external services). Set it to override (managed postgres etc).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/saas_template
# EMBEDDED_DB_DIR=~/.local/share/saas-template/pgdata
# USE_SQLITE=1 -- file DB at apps/api/dev.db instead of embedded postgres.
# Per-checkout file: multiple worktrees don't share a server. DATABASE_URL wins.

# Security
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Failed authentication attempts allowed per IP and account within the window.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Lockout in seconds once the window budget is spent (0 disables the lock).
# AUTH_RATE_LIMIT_LOCKOUT_SECONDS=900
# Registration attempts allowed per IP within the window (meters the
# verification email each registration sends; see #1343).
AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
FERNET_KEYS=change-me-fernet-key-32-bytes-min
SECRET_ENCRYPT_VERSION=1
SECRET_STORE_DRIVER=db
# bcrypt cost factor for password hashing (4..31, default 12).
# PASSWORD_HASH_ROUNDS=12

# Event bus: inprocess (dev) | nats (NATS JetStream)
EVENT_BUS_DRIVER=inprocess
NATS_URL=nats://localhost:4222

# Email: console (dev: log + in-memory capture, no delivery) | smtp
EMAIL_DRIVER=console
# Required when EMAIL_DRIVER=smtp: every SMTP send uses it as the sender.
EMAIL_FROM=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_S=10

# CORS_ORIGINS is comma separated. An entry containing `*` is a pattern: `*`
# stands for any run of origin characters, so it covers a subdomain
# (`*.example.com`), a port (`http://localhost:*`) or both. An entry without a
# scheme matches http and https. FRONTEND_URL is the single base URL used for
# the links in emails and OAuth redirects; a pattern there is skipped, so list
# a concrete URL first if the emails should not point at the default.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Browser session refresh cookie. The refresh token is HttpOnly (JS can never
# read it); the access JWT stays in frontend memory. Non-browser clients keep
# the JSON token bodies and are unaffected.
# REFRESH_COOKIE_NAME=st_refresh
# REFRESH_COOKIE_DOMAIN=  (empty = host-only; set to share across subdomains)
# REFRESH_COOKIE_PATH=/api/v1/auth
# REFRESH_COOKIE_SECURE=  an explicit true/false overrides both the request
# https detection and the ENVIRONMENT fallback; empty = Secure when the
# request arrived over https, else Secure unless ENVIRONMENT is development
# or test

# Superadmin bootstrap: the account registered with this email becomes the
# superuser (global scheduled jobs). Empty = no superadmin.
# Dev seed promotes admin@example.com regardless, so leave empty in dev.
SUPERADMIN_EMAIL=

# Auth methods: registration and password kill-switches.
# AUTH_ALLOW_REGISTRATION=false blocks new signups on every method: password
# register and OAuth first-connect both 403 (invitation accept needs an
# existing account, so it is unaffected). AUTH_PASSWORD_ENABLED=false disables password login/register,
# forcing SSO-only. Both default true (no behavior change).
# AUTH_ALLOW_REGISTRATION=true
# AUTH_PASSWORD_ENABLED=true

# SSO via any generic OIDC/OAuth2 provider (GitHub, GitLab, Google,
# Microsoft Entra, Okta). JSON list; empty = SSO disabled. Shapes:
# OIDC (Google/Entra/Okta/GitLab):
# {"id": "google", "display_name": "Google",
#  "discovery_url": "https://accounts.google.com/.well-known/openid-configuration",
#  "client_id": "...", "client_secret": "...", "scopes": "openid email profile"}
# Entra: "discovery_url": "https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration"
# The id_token `iss` claim is matched exactly against the provider's
# discovered/configured issuer, so an Entra "/<tenant>/v2.0" endpoint only
# accepts tokens minted for that tenant; a user from any other tenant gets
# "sign-in failed". Allow them with one provider entry per tenant (each with
# its own discovery_url/issuer).
# Okta: "issuer": "https://<domain>/oauth2/default" (discovery appended automatically)
# Non-OIDC (GitHub) -- GitHub's "scopes" must include user:email, and
# "emails_url" is required for accounts that keep their address private:
# /user then returns a null email and only /user/emails names the primary
# verified one. Without both, such an account gets "sign-in failed".
# "emails_url" is for non-OIDC providers only: an OIDC provider already
# states the address in the id_token; when /user then returns no email,
# /user/emails is one wasted GET per callback. A failing emails_url logs
# its own reason, so a 404 there means the token lacks the email scope.
# The "user" link key is the numeric account id, so it survives a rename or
# an email change.
# PKCE (S256) is always sent; a provider that rejects code_verifier shows up
# as "sign-in failed" in the browser and logs "oauth token endpoint error body".
# {"id": "github", "display_name": "GitHub",
#  "authorize_url": "https://github.com/login/oauth/authorize",
#  "token_url": "https://github.com/login/oauth/access_token",
#  "userinfo_url": "https://api.github.com/user",
#  "emails_url": "https://api.github.com/user/emails",
#  "client_id": "...", "client_secret": "...", "scopes": "read:user user:email"}
# The access token is sent to it, so it must be https on a host the config
# names ("token_url", "userinfo_url", "issuer", "discovery_url", "jwks_uri")
# or one the discovery document names; any other host is refused.
# GitHub Enterprise Server: same shape, REST endpoints under
# "https://<host>/api/v3/" (authorize/token stay "<host>/login/oauth/..."):
# "id" is the provider lookup key and the callback path segment, so keep it
# unique ("ghe" here) when github.com is enabled too.
# {"id": "ghe", "display_name": "GitHub Enterprise",
#  "authorize_url": "https://<host>/login/oauth/authorize",
#  "token_url": "https://<host>/login/oauth/access_token",
#  "userinfo_url": "https://<host>/api/v3/user",
#  "emails_url": "https://<host>/api/v3/user/emails",
#  "client_id": "...", "client_secret": "...", "scopes": "read:user user:email"}
# "issuer" is optional: omit it and the discovery document's "issuer" is used.
# Set it, and it is pinned -- logins then fail with "sign-in failed" unless it
# matches the discovery document's "issuer" (a trailing slash on either side is
# ignored), and changing the IdP's issuer means changing it here too.
# OAUTH_PROVIDERS=[]

# Single-workspace mode: one shared workspace, no switcher/invites needed.
# First login/register creates it (owned by whoever arrives first, normally
# the superadmin); later logins/registers auto-join as the role below (any
# system or custom role of that workspace). An unknown name falls through
# viewer -> editor -> admin -> an arbitrary remaining non-owner role, and a
# workspace with no non-owner role grants no membership. Creating a second
# workspace and deleting the workspace are rejected. Oldest workspace wins
# when toggled onto an existing deployment (extras stay hidden).
# The role name only picks the role a new member gets. Changing an existing
# member's role, suspending one and reactivating one all check the role name
# "owner" or "admin" (any case), and transferring ownership checks "owner", so
# a custom role set here cannot do any of them however open its permission
# list is (src/services/workspaces.py).
# SINGLE_WORKSPACE=false
# SINGLE_WORKSPACE_DEFAULT_ROLE=viewer

# Scheduled jobs
JOBS_SCHEDULER_TICK_SECONDS=10
JOBS_DEFAULT_TIMEOUT_SECONDS=600
JOBS_RUN_RETENTION=1000
JOBS_LOG_RETENTION_DAYS=90
NOTIFICATIONS_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=0
# Days a revoked or expired API key is kept before the apikeys.cleanup job
# hard-deletes it. 0 keeps them indefinitely.
API_KEY_RETENTION_DAYS=30
